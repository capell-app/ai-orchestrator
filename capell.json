{
    "manifest-version": 3,
    "name": "capell-app/ai-orchestrator",
    "slug": "ai-orchestrator",
    "displayName": "AI Orchestrator",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "2.0.0",
    "description": "Sets up the AI service, key and brand voice that Capell's AI features share, and adds an AI Assistant button to the page editor.",
    "product": {
        "group": "Capell AI",
        "tier": "free",
        "bundle": "ai"
    },
    "namespace": "Capell\\AIOrchestrator",
    "surfaces": ["admin"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/ai-creator",
            "capell-app/content-sections",
            "capell-app/media-ai",
            "capell-app/seo-suite",
            "capell-app/translation-manager"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\AIOrchestrator\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": [],
        "runtime": [
            "Capell\\AIOrchestrator\\Providers\\AIOrchestratorServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\AIOrchestrator\\Manifest\\AiOrchestratorAdminPageContribution",
            "pageClass": "Capell\\AIOrchestrator\\Filament\\Pages\\AIOrchestratorCapabilityCatalogPage",
            "labelKey": "capell-ai-orchestrator::package.catalog_title"
        },
        {
            "type": "console-command",
            "class": "Capell\\AIOrchestrator\\Manifest\\AiOrchestratorPruneScheduleContribution",
            "commands": ["capell:ai-orchestrator:prune-generation-payloads"],
            "commandClasses": [
                "Capell\\AIOrchestrator\\Console\\Commands\\PruneAiGenerationPayloadsCommand"
            ]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\AIOrchestrator\\Manifest\\AiOrchestratorPruneScheduleContribution",
            "command": "capell:ai-orchestrator:prune-generation-payloads",
            "name": "capell-ai-orchestrator-prune-generation-payloads",
            "frequency": "daily"
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": [
            "ai_generation_histories",
            "ai_generation_requests",
            "ai_managed_provider_calls"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "prune": "capell:ai-orchestrator:prune-generation-payloads"
    },
    "settings": ["Capell\\AIOrchestrator\\Settings\\AIOrchestratorSettings"],
    "permissions": [],
    "capabilities": ["ai-orchestrator", "ai-orchestrator-admin"],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [
                "Capell\\AIOrchestrator\\Models\\AIGenerationHistory::$error_message",
                "Capell\\AIOrchestrator\\Models\\AIGenerationHistory::$input",
                "Capell\\AIOrchestrator\\Models\\AIGenerationHistory::$metadata",
                "Capell\\AIOrchestrator\\Models\\AIGenerationHistory::$output",
                "Capell\\AIOrchestrator\\Models\\AiGenerationRequest::$error_message",
                "Capell\\AIOrchestrator\\Models\\AiGenerationRequest::$failures",
                "Capell\\AIOrchestrator\\Models\\AiGenerationRequest::$generated",
                "Capell\\AIOrchestrator\\Models\\AiGenerationRequest::$payload",
                "Capell\\AIOrchestrator\\Models\\ManagedProviderCall::$attempts",
                "Capell\\AIOrchestrator\\Models\\ManagedProviderCall::$terminal_result"
            ],
            "hashedTokenFields": [],
            "redactedOutputClasses": [
                "Capell\\AIOrchestrator\\Actions\\ResolveAIOrchestratorRuntimeSettingsAction",
                "Capell\\AIOrchestrator\\Filament\\Settings\\AIOrchestratorSettingsSchema",
                "Capell\\AIOrchestrator\\Support\\Ai\\PrismProvider",
                "Capell\\AIOrchestrator\\Support\\Ai\\Redaction\\RedactionResultData",
                "Capell\\AIOrchestrator\\Support\\Ai\\Redaction\\RegexPromptRedactor"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": ["Capell\\AIOrchestrator\\Support\\Ai\\PrismProvider"]
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "ai-orchestrator.package-health",
            "label": "AI Orchestrator package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\AIOrchestrator\\Health\\AiOrchestratorHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Connect your own AI service once, then let editors draft titles, descriptions and text for review.",
        "description": "For administrators who want AI help in the page editor with their own account and controls. Choose from OpenAI, Anthropic, Google Gemini or a self-hosted Ollama. Edit the prompt templates for titles, meta descriptions and content, and switch each one on or off. The key is stored encrypted and never shown again. The text of each request and result is cleared after 30 days by default, and a usage record stays. A read-only catalogue screen under System lists the AI features that other packages have registered. Spend limits are not included.",
        "problem": "You want AI help with titles and descriptions without pasting your content into a random website.",
        "outcome": "Editors get reviewable AI suggestions in the page editor, guided by your brand voice.",
        "faq": [
            {
                "question": "Can AI-written text go live without my editors checking it?",
                "answer": "No. Suggestions are drafts. Nothing reaches the live site until an editor reviews a suggestion and saves the page."
            },
            {
                "question": "Do I need my own account with an AI service?",
                "answer": "Yes. You need your own account with an AI service, or a self-hosted Ollama, and the site's background processing has to be running. An administrator adds your key and lists the models that are allowed."
            },
            {
                "question": "Does my visitors' or customers' personal information go to the AI service?",
                "answer": "By default, emails and phone numbers are swapped for placeholders before text is sent. Names and addresses are not, so keep them out of anything you ask the assistant to work on."
            },
            {
                "question": "Can I make the drafts sound like my organisation?",
                "answer": "Yes. An administrator can set a brand voice with a tone, words to avoid and examples. Drafts come back in the language version the editor picked."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/beta-contract.svg",
                "alt": "Dark illustration of four linked steps, register, govern, approve and show, marked as artwork and not a product screen.",
                "caption": "An illustration of the flow from setup through human review to the screen where the result appears."
            }
        ],
        "categories": ["admin", "commercial"]
    },
    "contributionTraceability": {
        "contributions": [
            {
                "type": "setting",
                "key": "settings-class:ai-orchestrator",
                "providerBucket": "runtime"
            },
            {
                "type": "setting",
                "key": "settings-schema:ai-orchestrator:AIOrchestratorSettingsSchema",
                "providerBucket": "runtime"
            }
        ]
    }
}
