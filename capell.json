{
    "manifest-version": 3,
    "name": "capell-app/ai-orchestrator",
    "slug": "ai-orchestrator",
    "displayName": "AI Orchestrator",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Shared AI capability registry and execution layer for Capell packages.",
    "product": {
        "group": "Capell Commercial",
        "tier": "premium",
        "bundle": "commercial"
    },
    "namespace": "Capell\\AIOrchestrator",
    "surfaces": ["admin"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/layout-builder"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\AIOrchestrator\\Providers\\AIOrchestratorServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["ai-orchestrator", "ai-orchestrator-admin"],
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "ai-orchestrator.package-health",
            "label": "AI Orchestrator package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\AIOrchestrator\\Health\\AiOrchestratorHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "The shared AI backbone for Capell packages: register, run, and govern AI-assisted capabilities from one admin-safe layer.",
        "screenshots": [
            {
                "path": "docs/screenshots/capability-list-or-prompt-surface-where-provided-by-a-consuming-package.png",
                "alt": "AI Orchestrator capability list in light mode",
                "caption": "Registered AI capabilities exposed by a consuming package"
            },
            {
                "path": "docs/screenshots/capability-list-or-prompt-surface-where-provided-by-a-consuming-package-dark.png",
                "alt": "AI Orchestrator capability list in dark mode",
                "caption": "Registered AI capabilities exposed by a consuming package in dark mode"
            },
            {
                "path": "docs/screenshots/layout-builder-layout-preview-workflow-if-layout-builder-integration-is-enabled.png",
                "alt": "Layout Builder AI layout preview workflow in light mode",
                "caption": "Layout Builder plan preview before content is applied"
            },
            {
                "path": "docs/screenshots/layout-builder-layout-preview-workflow-if-layout-builder-integration-is-enabled-dark.png",
                "alt": "Layout Builder AI layout preview workflow in dark mode",
                "caption": "Layout Builder plan preview before content is applied in dark mode"
            },
            {
                "path": "docs/screenshots/approval-state-where-a-capability-requires-review.png",
                "alt": "AI Orchestrator approval state in light mode",
                "caption": "Review state for an AI-assisted capability result"
            },
            {
                "path": "docs/screenshots/approval-state-where-a-capability-requires-review-dark.png",
                "alt": "AI Orchestrator approval state in dark mode",
                "caption": "Review state for an AI-assisted capability result in dark mode"
            }
        ],
        "categories": ["admin", "commercial"]
    }
}
