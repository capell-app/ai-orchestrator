                    "capell-ai-orchestrator.php": {
                        "cache.ttl": 86400,
                        "features.ai_content_brief.enabled": true,
                        "features.ai_content_brief.handler": null,
                        "features.ai_content_brief.model": "gpt-4o",
                        "features.ai_creator.enabled": true,
